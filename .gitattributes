# Normaliza los finales de línea para que el diff no se llene de ruido
# al cambiar de Windows a Linux (o al revés).
* text=auto

*.php  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.json text eol=lf

# Archivos que NO deben normalizarse
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pdf  binary
